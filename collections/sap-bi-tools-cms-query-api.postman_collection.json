          "id": "455dde92-6283-4707-998d-7185df0235ff",
          "name": "SAP BI Tools Execute a CMS query (GET)",
          "request": {
            "name": "SAP BI Tools Execute a CMS query (GET)",
            "description": {
              "content": "Executes a CMS query against the BI Platform repository using the query parameter. CMS queries use a SQL-like syntax to search for objects by type, name, and other properties.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "cmsquery"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "(Required) The CMS query string (e.g., SELECT * FROM CI_INFOOBJECTS WHERE SI_KIND='Webi')"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "The page number for pagination (1-based)"
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "50",
                  "description": "The number of items per page"
                }
              ],
              "variable": [
                {
                  "description": "The SAP Analytics Cloud tenant name",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                },
                {
                  "description": "The data center region (e.g., eu1, eu10, us1, us10, ap1)",
                  "type": "any",
                  "value": "{{datacenter}}",
                  "key": "datacenter"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",

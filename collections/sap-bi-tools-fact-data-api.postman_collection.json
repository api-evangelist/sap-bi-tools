          "name": "SAP BI Tools Get fact data from a model",
          "request": {
            "name": "SAP BI Tools Get fact data from a model",
            "description": {
              "content": "Retrieves fact data (transactional records) from a specific SAP Analytics Cloud model. Fact data includes dimension member values and measure values. Supports OData query parameters for filtering, selecting specific columns, ordering, and pagination.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "providers",
                "sac",
                ":modelId",
                "FactData"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "$format",
                  "value": "JSON",
                  "description": "The response format (JSON or XML)"
                },
                {
                  "disabled": false,
                  "key": "$top",
                  "value": "<integer>",
                  "description": "Maximum number of records to return"
                },
                {
                  "disabled": false,
                  "key": "$skip",
                  "value": "<integer>",
                  "description": "Number of records to skip for pagination"
                },
                {
                  "disabled": false,
                  "key": "$filter",
                  "value": "<string>",
                  "description": "OData filter expression to apply"
                },
                {
                  "disabled": false,
                  "key": "$select",
                  "value": "<string>",
                  "description": "Comma-separated list of properties to include"
                },
                {
                  "disabled": false,
                  "key": "$orderby",
                  "value": "<string>",
                  "description": "Property name and direction to sort by"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "modelId",
                  "description": "(Required) The unique provider (model) identifier"
                },
                {
                  "description": "The SAP Analytics Cloud tenant name",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                },
                {
                  "description": "The data center region (e.g., eu1, eu10, us1, us10, ap1)",
                  "type": "any",
                  "value": "{{datacenter}}",
                  "key": "datacenter"
                }
              ]
            },
            "header": [

        {
          "id": "246dec01-3a0f-4eba-90a4-3a6d43f07073",
          "name": "SAP BI Tools Get master data for a dimension",
          "request": {
            "name": "SAP BI Tools Get master data for a dimension",
            "description": {
              "content": "Retrieves the master data (member list with attributes) for a specific dimension within a model. The dimension name is appended with 'Master' to form the entity set name. Supports OData query parameters for filtering and pagination.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "providers",
                "sac",
                ":modelId",
                "{{dimensionName}}Master"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "$format",
                  "value": "JSON",
                  "description": "The response format (JSON or XML)"
                },
                {
                  "disabled": false,
                  "key": "$top",
                  "value": "<integer>",
                  "description": "Maximum number of records to return"
                },
                {
                  "disabled": false,
                  "key": "$skip",
                  "value": "<integer>",
                  "description": "Number of records to skip for pagination"
                },
                {
                  "disabled": false,
                  "key": "$filter",
                  "value": "<string>",
                  "description": "OData filter expression to apply"
                },
                {
                  "disabled": false,
                  "key": "$select",
                  "value": "<string>",
                  "description": "Comma-separated list of properties to include"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "modelId",
                  "description": "(Required) The unique provider (model) identifier"
                },

          "name": "SAP BI Tools List stories",
          "request": {
            "name": "SAP BI Tools List stories",
            "description": {
              "content": "Retrieves a list of stories available on the SAP Analytics Cloud tenant. Supports query parameters to include additional metadata such as models used in each story. Returns a JSON array of story objects with their identifiers, names, descriptions, and metadata.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "stories"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "include",
                  "value": "<string>",
                  "description": "Comma-separated list of related resources to include in the response (e.g., models)"
                }
              ],
              "variable": [
                {
                  "description": "The SAP Analytics Cloud tenant name",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                },
                {
                  "description": "The data center region (e.g., eu1, eu10, us1, us10, ap1)",
                  "type": "any",
                  "value": "{{datacenter}}",
                  "key": "datacenter"
                }

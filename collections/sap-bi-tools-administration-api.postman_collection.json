          "name": "SAP BI Tools List available providers (models)",
          "request": {
            "name": "SAP BI Tools List available providers (models)",
            "description": {
              "content": "Retrieves a list of providers (models) available for data export within a specific namespace. Each provider represents an SAP Analytics Cloud model with its name, description, and provider ID that can be used to access its data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "administration",
                "Namespaces(NamespaceID='{{namespaceId}}')",
                "Providers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "$format",
                  "value": "JSON",
                  "description": "The response format (JSON or XML)"
                },

          "name": "SAP BI Tools Get model metadata",
          "request": {
            "name": "SAP BI Tools Get model metadata",
            "description": {
              "content": "Retrieves the OData metadata document for a specific model. The metadata describes the structure of the model including its dimensions, measures, and available entity sets for querying fact data and master data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "providers",
                "sac",
                ":modelId",
                "$metadata"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "$format",
                  "value": "JSON",
                  "description": "The response format (JSON or XML)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "modelId",
                  "description": "(Required) The unique provider (model) identifier"
                },
                {
                  "description": "The SAP Analytics Cloud tenant name",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                },
                {
                  "description": "The data center region (e.g., eu1, eu10, us1, us10, ap1)",
                  "type": "any",
                  "value": "{{datacenter}}",
                  "key": "datacenter"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "GET",
            "auth": null
          },

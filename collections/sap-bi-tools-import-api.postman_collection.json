          "request": {
            "name": "SAP BI Tools Import a content item",
            "description": {
              "content": "Imports a content item from the Content Network into the local SAP Analytics Cloud tenant. The imported content and its dependencies are created in the tenant's file repository.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "contentnetwork",
                "items",
                ":itemId",
                "import"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "itemId",
                  "description": "(Required) The unique identifier of the content item"
                },
                {
                  "description": "The SAP Analytics Cloud tenant name",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                },
                {
                  "description": "The data center region (e.g., eu1, eu10, us1, us10, ap1)",
                  "type": "any",
                  "value": "{{datacenter}}",
                  "key": "datacenter"
                }
              ]
            },

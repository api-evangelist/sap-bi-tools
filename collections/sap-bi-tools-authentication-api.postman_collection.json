          "id": "43d81cb8-406c-4520-b7c8-a3d1fce9977a",
          "name": "SAP BI Tools Log on to BI Platform",
          "request": {
            "name": "SAP BI Tools Log on to BI Platform",
            "description": {
              "content": "Authenticates a user against the BI Platform and returns a logon token that must be included in subsequent API requests. Supports Enterprise, LDAP, and Windows AD authentication types.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "logon",
                "long"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The SAP Analytics Cloud tenant name",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                },
                {
                  "description": "The data center region (e.g., eu1, eu10, us1, us10, ap1)",
                  "type": "any",
                  "value": "{{datacenter}}",
                  "key": "datacenter"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"<string>\",\n  \"password\": \"<password>\",\n  \"auth\": \"secEnterprise\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },

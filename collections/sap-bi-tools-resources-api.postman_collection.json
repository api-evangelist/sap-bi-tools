          "name": "SAP BI Tools List resources",
          "request": {
            "name": "SAP BI Tools List resources",
            "description": {
              "content": "Retrieves a list of resources from the SAP Analytics Cloud file repository. Resources include stories, models, folders, and other artifacts. Supports filtering by resource type and pagination.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "Resources"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "resourceType",
                  "value": "<string>",
                  "description": "Filter resources by type (e.g., STORY, MODEL, FOLDER)"
                },
                {
                  "disabled": false,
                  "key": "resourceSubType",
                  "value": "<string>",
                  "description": "Filter resources by sub-type"
                },
                {
                  "disabled": false,
                  "key": "$top",
                  "value": "<integer>",
                  "description": "Maximum number of records to return"
                },
                {
                  "disabled": false,
                  "key": "$skip",
                  "value": "<integer>",
                  "description": "Number of records to skip for pagination"
                }
              ],
              "variable": [
                {
                  "description": "The SAP Analytics Cloud tenant name",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                },
                {
                  "description": "The data center region (e.g., eu1, eu10, us1, us10, ap1)",
                  "type": "any",
                  "value": "{{datacenter}}",
                  "key": "datacenter"
                }
              ]
            },
            "header": [
